<?xml version="1.0" encoding="utf-8"?>
<!-- Bu modülün manifesti uygulamanın manifestiyle otomatik birleştirilir (prebuild gerekmez). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Ana ekran widget'ı: mobil sinyal gücü -->
    <receiver
      android:name="expo.modules.signalstrength.SignalWidgetProvider"
      android:exported="true"
      android:label="@string/ss_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ss_widget_signal_info" />
    </receiver>

    <!-- Ana ekran widget'ı: hız testi (son sonuç + Başlat) -->
    <receiver
      android:name="expo.modules.signalstrength.SpeedWidgetProvider"
      android:exported="true"
      android:label="@string/ss_widget_speed_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ss_widget_speed_info" />
    </receiver>

    <!-- Hızlı Ayarlar kutucuğu: mobil sinyal gücü -->
    <service
      android:name="expo.modules.signalstrength.SignalTileService"
      android:exported="true"
      android:icon="@drawable/ss_tile_signal"
      android:label="@string/ss_tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data
        android:name="android.service.quicksettings.TOGGLEABLE_TILE"
        android:value="false" />
    </service>
  </application>
</manifest>