<?xml version="1.0" encoding="utf-8"?>
<!-- Hız testi widget'ı: son test sonucu + "Başlat" butonu (uygulamayı Hız Testi sekmesinde açıp testi başlatır) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/ss_speed_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/ss_widget_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="16dp"
  android:paddingTop="8dp"
  android:paddingEnd="8dp"
  android:paddingBottom="8dp">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/ss_speed_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:text="@string/ss_widget_speed_title"
      android:textColor="@color/ss_widget_muted"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/ss_speed_values"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="↓ 245 · ↑ 38 Mbps"
      android:textColor="@color/ss_widget_text"
      android:textSize="18sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/ss_speed_detail"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Ping 12 ms · 14:05"
      android:textColor="@color/ss_widget_muted"
      android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/ss_speed_start"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:background="@drawable/ss_widget_button_light"
    android:maxLines="1"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="14dp"
    android:paddingBottom="9dp"
    android:text="@string/ss_widget_start"
    android:textColor="#FFFFFF"
    android:textSize="14sp"
    android:textStyle="bold" />

  <ImageView
    android:id="@+id/ss_speed_theme"
    android:layout_width="34dp"
    android:layout_height="34dp"
    android:layout_marginStart="2dp"
    android:contentDescription="@string/ss_widget_theme"
    android:padding="8dp"
    android:src="@drawable/ss_widget_sun"
    android:tint="@color/ss_widget_muted" />
</LinearLayout>